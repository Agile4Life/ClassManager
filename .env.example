NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres
DATABASE_SSL=true
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_DAYS=7
# Keep false unless explicitly testing password reset without an email provider.
EXPOSE_RESET_TOKEN=false
# Comma-separated allowlist, for example: http://localhost:5173,http://localhost:3001
CORS_ORIGIN=http://localhost:5173
