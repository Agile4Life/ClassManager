{
  "name": "class-manager-backend",
  "version": "1.0.0",
  "description": "Backend API for the ClassManager tuition center system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "check": "node scripts/check-syntax.js",
    "db:check": "node scripts/check-database.js",
    "test": "node scripts/check-regressions.js",
    "dev:frontend": "npm --prefix frontend run dev -- --configLoader runner",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend install --include=dev && npm --prefix frontend run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
